# === Holishared Configuration ===

# === Docker / Nginx ===
# Port externe du container Nginx (accessible depuis l'hôte)
NGINX_PORT=8080

# === Serveur ===
APP_HOST=0.0.0.0
APP_PORT=8400
APP_THREADS=4

# === Sécurité ===
# Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
# Durée (secondes) des sessions invité/créateur, glissante : 30 jours par défaut. Le cookie de
# session et le cookie « se souvenir » (créateur) survivent à la fermeture du navigateur ; le
# compromis est qu'un appareil partagé reste connecté tant qu'on n'utilise pas « Se déconnecter »
# / « Oublier cet appareil » (menu et page « Mes événements »).
PERMANENT_SESSION_LIFETIME=2592000
# Affiche le lien de vérification et le code personnel SANS SMTP (dev/staging uniquement).
# Défaut false : sans SMTP, aucun secret n'est jamais affiché.
DEV_SHOW_SECRETS=false

# === Base de données ===
# En Docker, le volume est monté sur /app/instance
DATABASE_URL=sqlite:////app/instance/holishared.db

# === Redis (rate limiting) ===
# En Docker : redis://redis:6379/0 (service Docker)
# En dev local : vide = in-memory
REDIS_URL=redis://redis:6379/0

# === Superadmin (gestion du site) ===
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# === Domaine ===
APP_DOMAIN=localhost
APP_URL=http://localhost:8080

# === Freemium limits (default = free tier) ===
MAX_GUESTS_PER_EVENT=10
MAX_DURATION_DAYS=30
MAX_EVENTS_PER_CREATOR=3
ENABLED_MODULES=planning,meals,lists,logistics,voting,media,chat,costs

# === Push notifications (Web Push, B027) ===
# Clés générées par `python manage.py init`. Vides : section
# « Notifications » affichée comme indisponible, aucune erreur. Docker : le service `worker`
# reçoit VAPID_PRIVATE_KEY, VAPID_CLAIMS_SUBJECT et DATABASE_URL (la clé ne passe pas par Redis).
# VAPID_CLAIMS_SUBJECT : mailto: ou https: de contact de l'exploitant (exigé par les services de push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:admin@holishared.local

# === Anti-abus ===
RATE_LIMIT_CREATE=5/hour
RATE_LIMIT_INVITE=20/hour
BLOCKED_EMAIL_DOMAINS=mailinator.com,temp-mail.com,10minutemail.com,guerrillamail.com,yopmail.com,throwaway.email

# === Email (validation créateur) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=holishared@localhost

# === i18n ===
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en

# === Logs ===
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# === PWA ===
# Service worker (désactiver : false)
SW_ENABLED=true

# Catalogue de composants /_ui (développement uniquement)
# UI_CATALOG_ENABLED=false

# === Outillage / tests (optionnel) ===
# Dossier instance de Flask (défaut : <projet>/instance). Les sauvegardes pré-migration
# vont dans <INSTANCE_PATH>/backups/ ; la base SQLite par défaut reste <projet>/instance/holishared.db
# (déplacez-la via DATABASE_URL), la restauration copie donc depuis ce dossier backups/.
# INSTANCE_PATH=
# Migration d'identité au démarrage : seule la valeur « 1 » la désactive (utilisée par
# `python -m app.migrations check`, qui doit rester en lecture seule). Défaut : migration active.
# SKIP_STARTUP_MIGRATION=1
