          "type": "assert",
          "expr": "document.querySelector('[data-testid=privacy-sheet]').open",
          "message": "la feuille confidentialité est ouverte"
        }
      ]
    },
    {
      "id": "confirm-dialog",
      "lot": "B017",
      "role": "anonymous",
      "path": "/_ui",
      "scope": "page",
      "expect": {
        "nav": "global"
      },
      "langs": [
        "fr"
      ],
