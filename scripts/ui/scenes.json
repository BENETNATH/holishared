      "id": "event-long-title",
      "lot": "B017",
      "role": "creator",
      "path": "/e/{event.long}",
      "scope": "shell",
      "expect": {
        "nav": "event"
      },
      "langs": [
        "fr"
      ],
      "actions": [
        {
          "type": "assert",
          "expr": "(e => e.scrollWidth > e.clientWidth && e.getBoundingClientRect().right <= innerWidth)(document.querySelector('[data-testid=header-event-title]'))",
          "message": "titre long tronqué par CSS dans la largeur"
        }
      ]
    },
    {
      "id": "more-sheet",
      "lot": "B017",
      "role": "guest_household",
      "path": "/e/{event.rich}/chat",
      "scope": "shell",
      "expect": {
        "nav": "event"
      },
      "langs": [
        "fr"
      ],
      "viewports": [
        360,
        390,
        820
      ],
      "actions": [
        {
          "type": "click",
          "target": "[data-testid=tab-more]"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=more-sheet]').open",
          "message": "la feuille Plus est ouverte"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=more-sheet]').contains(document.activeElement)",
          "message": "le focus est dans la feuille"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=more-item-chat]').getAttribute('aria-current') === 'page'",
          "message": "l'entrée de la page courante est marquée"
        },
        {
          "type": "press",
          "key": "Escape"
        },
        {
          "type": "assert",
          "expr": "!document.querySelector('[data-testid=more-sheet]').open",
          "message": "Échap ferme la feuille"
        },
        {
          "type": "assert",
          "expr": "document.activeElement === document.querySelector('[data-testid=tab-more]')",
          "message": "le focus revient au déclencheur"
        }
      ]
    },
    {
      "id": "privacy-sheet",
      "lot": "B017",
      "role": "anonymous",
      "path": "/",
      "scope": "shell",
      "expect": {
