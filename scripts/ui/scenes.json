      ],
      "note": "le catalogue montre volontairement chaque variante",
      "actions": [
        {
          "type": "click",
          "target": "[data-testid=catalog-confirm-trigger]"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=confirm-dialog]')?.open",
          "message": "le dialogue de confirmation est ouvert"
        },
        {
          "type": "assert",
          "expr": "document.activeElement === document.querySelector('[data-testid=confirm-cancel]')",
          "message": "le focus initial est sur Annuler"
        }
      ]
    },
    {
      "id": "sheet-toast",
      "lot": "B017",
      "role": "anonymous",
      "path": "/_ui",
      "scope": "page",
      "expect": {
        "nav": "global"
      },
      "langs": [
        "fr"
      ],
      "viewports": [
        390,
        1280
      ],
      "skip": [
        "primary"
      ],
      "note": "le catalogue montre volontairement chaque variante",
      "actions": [
        {
          "type": "click",
          "target": "[data-testid=catalog-sheet-trigger]"
        },
        {
          "type": "click",
          "target": "[data-testid=catalog-sheet-copy]"
        },
        {
          "type": "waitFor",
          "timeout": 2000,
          "expr": "(() => { const t = [...document.querySelectorAll('.ui-toast')].pop(); if (!t) return false; const r = t.getBoundingClientRect(); const el = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2); return t.contains(el); })()",
          "message": "toast visible et au-dessus de la feuille ouverte"
        }
      ]
    },
    {
      "id": "more-sheet-motion",
      "lot": "B017",
      "role": "guest_household",
      "path": "/e/{event.rich}/chat",
      "scope": "shell",
      "expect": {
        "nav": "event"
      },
      "langs": [
        "fr"
      ],
      "viewports": [
        390
      ],
      "themes": [
        "light"
      ],
      "reducedMotion": false,
      "actions": [
        {
          "type": "click",
          "target": "[data-testid=tab-more]"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=more-sheet]').open",
          "message": "la feuille Plus est ouverte"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=more-sheet]').contains(document.activeElement)",
          "message": "le focus est dans la feuille"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=more-item-chat]').getAttribute('aria-current') === 'page'",
          "message": "l'entrée de la page courante est marquée"
        },
        {
          "type": "press",
          "key": "Escape"
        },
        {
          "type": "assert",
          "expr": "!document.querySelector('[data-testid=more-sheet]').open",
          "message": "Échap ferme la feuille"
        },
        {
          "type": "assert",
          "expr": "document.activeElement === document.querySelector('[data-testid=tab-more]')",
          "message": "le focus revient au déclencheur"
        },
        {
          "type": "click",
          "target": "[data-testid=tab-more]"
        },
        {
          "type": "click",
          "target": "[data-testid=more-item-privacy]"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=privacy-sheet]').open && !document.querySelector('[data-testid=more-sheet]').open",
          "message": "la confidentialité remplace la feuille Plus"
        }
      ]
    },
    {
      "id": "pwa-offline",
      "lot": "B017",
      "role": "guest_household",
      "path": "/e/{event.rich}",
      "scope": "page",
      "expect": {
        "nav": "none"
      },
      "langs": [
        "fr"
      ],
      "viewports": [
        390
      ],
      "themes": [
        "light"
      ],
      "actions": [
        {
          "type": "waitFor",
          "expr": "navigator.serviceWorker.ready.then(() => true)"
        },
        {
          "type": "reload"
        },
        {
          "type": "assert",
          "expr": "navigator.serviceWorker.controller !== null",
          "message": "le SW contrôle la page"
        },
        {
          "type": "offline"
        },
        {
          "type": "navigate",
          "path": "/e/{event.rich}/planning"
        },
        {
          "type": "assert",
          "expr": "document.querySelector('[data-testid=offline-page]') !== null",
          "message": "page hors ligne servie"
        }
      ]
    }
  ]
