#: app/tasks.py
#, python-format
msgid ""
"Bonjour,\n"
"\n"
"Vous avez créé l'événement « %(title)s » sur holishared.\n"
"\n"
"Pour finaliser, cliquez sur ce lien (valide 3 jours) :\n"
"\n"
"%(url)s\n"
"\n"
"Vous y définirez votre code personnel et votre pseudo, et vous pourrez "
"inviter vos proches.\n"
"\n"
"— holishared\n"
msgstr ""
"Hello,\n"
"\n"
"You created the event “%(title)s” on holishared.\n"
"\n"
"To finish, click this link (valid for 3 days):\n"
"\n"
"%(url)s\n"
"\n"
"There you will set your personal code and nickname, and you can invite "
"your friends and family.\n"
"\n"
"— holishared\n"

